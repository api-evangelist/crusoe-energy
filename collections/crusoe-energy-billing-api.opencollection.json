            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/organizations/:organization_id/billing/costs",
            "params": [
              {
                "name": "organization_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path"
              }
            ]
          },
          "docs": "Get the daily spend for a specified organization by project."
        },
        {
