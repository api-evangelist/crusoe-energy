            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/:project_id/kubernetes/nodepools",
            "params": [
              {
                "name": "project_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path"
              },
              {
                "name": "cluster_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "created_at, -created_at",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve information about Kubernetes node pools belonging to a project or cluster."
        },
        {
          "info": {
            "name": "Create a new Kubernetes node pool owned by the logged in user.",
            "type": "http"
          },
