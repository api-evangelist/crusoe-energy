              },
              {
                "name": "node_pool_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve information about a particular slurm node pool belonging to the project."
        },
        {
