              }
            ]
          },
          "docs": "Retrieve information about slurm node pools belonging to a project or cluster."
        },
        {
          "info": {
            "name": "Create a new slurm node pool owned by the logged in user.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/projects/:project_id/slurm/nodepools",
            "params": [
