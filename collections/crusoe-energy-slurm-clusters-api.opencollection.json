          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/projects/:project_id/slurm/clusters",
            "params": [
              {
                "name": "project_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
                "type": "path"
              }
            ]
          },
          "docs": "A successful response from this resource will contain the async operation ID."
        },
        {
          "info": {
            "name": "Retrieve information about a particular slurm cluster belonged to the project.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/projects/:project_id/slurm/clusters/:cluster_id",
            "params": [
              {
                "name": "project_id",
                "value": "ab4a6b00-aa5f-408e-a9fb-ac6de5eb45ab",
